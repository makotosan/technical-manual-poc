{
  "name": "technical-manual-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-HTML technical manual publishing PoC",
  "engines": {
    "node": "24.19.0",
    "npm": "10.7.0"
  },
  "packageManager": "npm@10.7.0",
  "scripts": {
    "dev": "eleventy --serve",
    "build:web": "node scripts/build-manual.mjs --format=web",
    "build:pdf": "node scripts/build-manual.mjs --format=both",
    "test": "npm run build:web && npm run build:pdf:from-html && npm run test:artifacts && npm run check:reproducibility && npm run test:propagation",
    "build:pdf:from-html": "node scripts/build-manual.mjs --format=pdf --skip-web",
    "check:pdf": "node scripts/validate-pdf.mjs",
    "test:artifacts": "node --test --test-concurrency=1",
    "check:reproducibility": "node scripts/check-reproducibility.mjs",
    "test:propagation": "node scripts/check-propagation.mjs",
    "spike:dev": "eleventy --config=eleventy.spike.config.js --serve --port=8081",
    "spike:build:web": "eleventy --config=eleventy.spike.config.js",
    "spike:build:pdf": "npm run spike:build:web && node scripts/build-spike-pdf.mjs",
    "spike:test": "npm run spike:build:pdf && node --test spike-checks/acceptance.mjs",
    "visual:build:web": "eleventy --config=eleventy.visual.config.js",
    "visual:build:pdf": "npm run visual:build:web && node scripts/build-visual-pdf.mjs",
    "visual:test": "npm run visual:build:pdf && node --test visual-checks/acceptance.mjs",
    "visual:browser": "node scripts/check-visual-browser.mjs",
    "v02:test": "node scripts/build-manual.mjs --variant=v0.2 --output-prefix=dist-v02 && node --test publication-checks/acceptance.mjs",
    "v02:browser": "node scripts/check-publication-browser.mjs",
    "editorial:check": "node scripts/check-editorial.mjs",
    "pages:stage": "node scripts/stage-pages.mjs",
    "v02:reproducibility": "node scripts/check-publication-reproducibility.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@vivliostyle/cli": "11.4.0",
    "pdf-lib": "1.17.1",
    "mupdf": "1.28.0"
  }
}
